<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleName</key><string>Locompass</string>
    <key>CFBundleDisplayName</key><string>Locompass</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>UILaunchScreen</key><dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array><string>UIInterfaceOrientationPortrait</string></array>

    <key>NSSupportsLiveActivities</key><true/>
    <key>NSSupportsLiveActivitiesFrequentUpdates</key><true/>

    <key>NSNearbyInteractionUsageDescription</key>
    <string>Used to point an arrow toward your nearby friends.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Used to point the arrow toward friends and share your position with them.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Always access keeps you findable by friends while your phone is locked.</string>

    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Used so friends can find you while your phone is locked.</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>bluetooth-peripheral</string>
        <string>location</string>
    </array>

    <key>NSLocalNetworkUsageDescription</key>
    <string>Used to discover and connect to nearby friends.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_uwbcompass._tcp</string>
        <string>_uwbcompass._udp</string>
    </array>
</dict>
</plist>
