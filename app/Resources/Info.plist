<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleName</key><string>CompassFriends</string>
    <key>CFBundleDisplayName</key><string>Compass Friends</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>UILaunchScreen</key><dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array><string>UIInterfaceOrientationPortrait</string></array>

    <key>NSNearbyInteractionUsageDescription</key>
    <string>Used to point an arrow toward your nearby friends.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Used to smooth the arrow when UWB direction is briefly lost.</string>

    <key>NSLocalNetworkUsageDescription</key>
    <string>Used to discover and connect to nearby friends.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_uwbcompass._tcp</string>
        <string>_uwbcompass._udp</string>
    </array>
</dict>
</plist>
